# ============================================================================
# Casa de Leilões: variáveis de ambiente
#
# O docker-compose.yml já tem valores padrão para DESENVOLVIMENTO LOCAL, então
# `docker compose up --build` funciona SEM este arquivo.
#
# Para rodar o compose num servidor público: copie para `.env` e TROQUE os segredos
# (nunca commite o .env).  cp .env.example .env
# ============================================================================

# --- PostgreSQL (container "db") ---
POSTGRES_USER=leilao
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=leilao

# --- Segredos da API (mínimo de 16 caracteres cada; gere valores longos e aleatórios) ---
# Assinatura dos tokens de login (JWT).
#   Gerar: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-1
# Segredo do HMAC da cadeia de hashes da auditoria e dos pseudônimos.
# ATENÇÃO: trocá-lo depois de existirem lances invalida a verificação de integridade
# dos lotes antigos (aparecerão como adulterados). Defina uma vez e guarde com cuidado.
#   Gerar: openssl rand -base64 48
AUDIT_SECRET=troque-por-um-segredo-longo-e-aleatorio-2

# Duração do login (formato do jsonwebtoken: 15m, 12h, 7d...).
JWT_EXPIRES_IN=7d

# --- Rede / CORS (DESENVOLVIMENTO LOCAL) ---
# Origem(ns) do FRONT permitidas pela API (separe por vírgula).
CORS_ORIGINS=http://localhost:3000
# Endereço PÚBLICO da API, como o navegador o enxerga. É embutido no build do front:
# se mudar, rode `docker compose up --build` de novo.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Em produção na Northflank NÃO se usa este arquivo: as variáveis são cadastradas nos serviços
# (veja o README, seção "Deploy na Northflank"). Lá o front usa `API_URL` (runtime, sem rebuild).

# Portas publicadas no host (só no docker-compose local).
WEB_PORT=3000
API_PORT=4000

# --- Dados de demonstração ---
# true  = a cada início, cria contas/lotes de demonstração que faltarem (útil para avaliação).
# false = produção "de verdade".
SEED_ON_BOOT=true

# --- API externa de itens (Cleveland Museum of Art Open Access, sem chave) ---
CATALOG_API_URL=https://openaccess-api.clevelandart.org/api
CATALOG_TIMEOUT_MS=5000
