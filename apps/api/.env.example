# Desenvolvimento da API FORA do Docker (npm run start:dev).
# Copie para `.env` (ignorado pelo git):  cp .env.example .env
# O Postgres pode vir do compose de desenvolvimento (veja o README, seção "Sem Docker").

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://leilao:leilao@127.0.0.1:5432/leilao?schema=public

# Mínimo de 16 caracteres cada. Em produção use valores longos e aleatórios.
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=7d
AUDIT_SECRET=dev-only-audit-secret-change-me-in-production

CORS_ORIGINS=http://localhost:3000
SEED_ON_BOOT=true

CATALOG_API_URL=https://openaccess-api.clevelandart.org/api
CATALOG_TIMEOUT_MS=5000
